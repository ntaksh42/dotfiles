{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git worktree:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(which:*)",
      "Bash(where:*)",
      "Bash(type:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(poetry:*)",
      "Bash(dotnet:*)",
      "Bash(msbuild:*)",
      "Bash(nuget:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(cmake:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(jest:*)",
      "Bash(pytest:*)",
      "Bash(vitest:*)",
      "Bash(jq:*)",
      "Bash(gh:*)",
      "Bash(az --version:*)",
      "Bash(az account show:*)",
      "Bash(az devops:*)",
      "Bash(chcp:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/credentials.json)",
      "Read(//**/secrets.json)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p12)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/credentials.json)",
      "Edit(//**/secrets.json)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.pfx)",
      "Edit(//**/*.p12)",
      "Edit(//**/appsettings.Development.json)",
      "Edit(//**/appsettings.Production.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.32",
    "padding": 0
  },
  "enabledPlugins": {
    "dotfiles@dotfiles-mods": true
  },
  "extraKnownMarketplaces": {
    "dotfiles-mods": {
      "source": {
        "source": "directory",
        "path": "{{REPO_DIR}}"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true
}
